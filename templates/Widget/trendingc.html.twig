<!-- Section Title -->
<div class="section-heading">
    {% set caption = 'menu.current.label' %}
    <h5>Currently active {{ caption|trans }}</h5>
</div>
{% for vote in votesc %}
    {% if app.user %}
        {% if app.user.country == vote.category.description or vote.category.country == "UN" %}
             <!-- Single Trending Post -->
            <div class="single-blog-post d-flex">
                <div class="post-thumbnail">
                    <img src="{{ asset(vote.category.imageSmall) }}" alt=""/>
                </div>
                <div class="post-content">
                    <a href="{{ path('initiative_show', { 'id': vote.id, 'slug': vote.slug }) }}" class="post-title">{{ vote.title }}</a>
                    <div class="post-meta d-flex justify-content-between">
                        <a href="#"><i class="fas fa-eye" aria-hidden="true"></i> {{ vote.views }}</a>
                        <a href="#"><i class="fas fa-comments" aria-hidden="true"></i> {{ vote.countComments }}</a>
                    </div>
                </div>
            </div>
        {% endif %}
    {% else %}
        {% if vote.category.country == "UN" %}
             <!-- Single Trending Post -->
            <div class="single-blog-post d-flex">
                <div class="post-thumbnail">
                    <img src="{{ asset(vote.category.imageSmall) }}" alt=""/>
                </div>
                <div class="post-content">
                    <a href="{{ path('initiative_show', { 'id': vote.id, 'slug': vote.slug }) }}" class="post-title">{{ vote.title }}</a>
                    <div class="post-meta d-flex justify-content-between">
                        <a href="#"><i class="fas fa-eye" aria-hidden="true"></i> {{ vote.views }}</a>
                        <a href="#"><i class="fas fa-comments" aria-hidden="true"></i> {{ vote.countComments }}</a>
                    </div>
                </div>
            </div>

        {% endif %}
    {% endif %}
{% endfor %}