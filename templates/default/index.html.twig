{% extends 'base.html.twig' %}

{% block body %}

    <!-- ##### Hero Area Start ##### -->

    {{ include ('/Widget/hero_mission.html.twig', with_context = false) }}
    {{ include ('Widget/_flashes-danger.html.twig', {flashes: app.flashes}, with_context = false) }}


    <!-- ##### Hero Area End ##### -->

    <!-- ##### Mag Posts Area Start ##### -->
    <section class="mag-posts-area d-flex flex-wrap">

        <!-- >>>>>>>>>>>>>>>>>>>>
         Post Left Sidebar Area
        <<<<<<<<<<<<<<<<<<<<< -->
        <div class="post-sidebar-area left-sidebar m-t-30 m-b-30 bg-white box-shadow sticky-sidebar">
            {# Desktop Left Sidebar - only visible on Desktop #}
            <div class="desktop-only">
                <div class="single-sidebar-widget p-30">
                    <div class="section-heading">
                        <h5 class="text-dark">Global Democracy</h5>
                    </div>
                    <div class="widget-content-bg bg-img bg-overlay p-30" style="background-image: url('{{ asset('assets/img/header/initiative_small.jpg') }}');">
                        <div class="wpe-sidebar-text">
                            <p class="text-white" style="font-size: 14px; line-height: 1.4; font-weight: bold; margin-bottom: 10px;">Global Democracy is possible, if YOU take part in it!</p>
                            <p class="text-white" style="font-size: 14px; line-height: 1.4;">Create your own political proposals or vote on real-world political initiatives.</p>
                            <p class="text-white" style="font-size: 14px; line-height: 1.4; margin-top: 10px;">To start, <a href="{{ path("login") }}" class="text-white" style="text-decoration: underline;">login</a> or create a <a href="{{ path("app_register") }}" class="text-white" style="text-decoration: underline;">user account</a>.</p>
                            <p class="text-white" style="font-size: 14px; line-height: 1.4; margin-top: 10px;">This project is completely open source. To contribute, please check out our <a href="https://github.com/world-parliament-experiment/WPE" class="text-white" style="text-decoration: underline;">GitHub project</a>. There you will also find a <a href="https://github.com/world-parliament-experiment/WPE/wiki" class="text-white" style="text-decoration: underline;">Wiki</a> where you can contribute ideas or draft your next proposals before posting them on the website.</p>
                        </div>
                    </div>
                </div>
                
                <div class="single-sidebar-widget p-30 w-categories-current">
                    {{ render(controller('App\\Controller\\WidgetController::CategoriesOverviewAction', { 'type': 'current' })) }}
                </div>
                <div class="single-sidebar-widget p-30 w-popular">
                   {{ render(controller('App\\Controller\\WidgetController::MostPopularAction')) }}
                </div>
                <div class="single-sidebar-widget p-30 w-views">
                    {{ render(controller('App\\Controller\\WidgetController::MostViewsAction')) }}
                </div>
                <div class="single-sidebar-widget p-30 w-citizens">
                    {{ render(controller('App\\Controller\\WidgetController::mostCitizensByCountryAction')) }}
                </div>
            </div>
        </div>

        <!-- >>>>>>>>>>>>>>>>>>>>
             Main Posts Area
        <<<<<<<<<<<<<<<<<<<<< -->

        <div class="mag-posts-content m-t-30 m-b-30 p-30 box-shadow">
            
            <div class="feature-video-posts m-b-30">

                <div class="feed-filter-bar mb-4">
                    <div class="btn-group w-100" role="group">
                        <a href="{{ path('homepage') }}" class="btn filter-btn {{ current_filter is empty ? 'active' : '' }}">All</a>
                        <a href="{{ path('homepage', {type: 'article'}) }}" class="btn filter-btn {{ current_filter == 'article' ? 'active' : '' }}">Articles</a>
                        <a href="{{ path('homepage', {type: 'proposal'}) }}" class="btn filter-btn {{ current_filter == 'proposal' ? 'active' : '' }}">Proposals</a>
                        <a href="{{ path('homepage', {type: 'vote'}) }}" class="btn filter-btn {{ current_filter == 'vote' ? 'active' : '' }}">Ongoing Votes</a>
                    </div>
                </div>

                <div class="proposal-grid single-column-feed">
                    {% for item in feed_items %}
                        <div class="proposal-card bg-img bg-overlay" style="background-image: url('{{ asset(item.category.image) }}'); margin-bottom: 30px; flex: 0 0 100%; max-width: 100%;">
                            <div class="proposal-content">
                                <div class="proposal-meta">
                                    <a href="{{ path('category_type', {id: item.category.id, slug:item.category.slug, type:item.typename|lower}) }}">{{ item.category.name }}</a>
                                    <span class="text-white ml-2">• {{ item.publishedAt|date('d.m.Y') }}</span>
                                </div>
                                <a href="{{ path('initiative_show', {id: item.id,slug:item.slug}) }}" class="proposal-title">{{ item.title }}</a>
                                
                                <div class="proposal-description text-white mb-3" style="font-size: 14px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; white-space: pre-line;">
                                    {{ item.description|replace({'</p>': "\n", '<br>': "\n", '<br />': "\n"})|striptags|trim }}
                                </div>

                                <div class="proposal-action">
                                    {% if item.type == 4 %} {# TYPE_ARTICLE #}
                                        <a href="{{ path('initiative_show', {id: item.id,slug:item.slug}) }}" class="btn mag-btn btn-sm">Read More</a>
                                    {% elseif item.type == 1 %} {# TYPE_CURRENT #}
                                        <a href="{{ path('initiative_show', {id: item.id,slug:item.slug}) }}" class="btn mag-btn btn-sm">Vote Now</a>
                                    {% else %} {# TYPE_FUTURE or others #}
                                        <a href="{{ path('initiative_show', {id: item.id,slug:item.slug}) }}" class="btn mag-btn btn-sm">Discuss Now</a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p>No items in the feed at the moment.</p>
                    {% endfor %}
                </div>
            </div>

            {# MOBILE & TABLET INTERLEAVED WIDGETS #}
            <div class="mobile-tablet-only">
                <div class="interleaved-widgets-container">
                    {# L1: Global Democracy #}
                    <div class="single-sidebar-widget p-30 m-b-30">
                        <div class="section-heading">
                            <h5 class="text-dark">Global Democracy</h5>
                        </div>
                        <div class="widget-content-bg bg-img bg-overlay p-30" style="background-image: url('{{ asset('assets/img/header/initiative_small.jpg') }}');">
                            <div class="wpe-sidebar-text">
                                <p class="text-white" style="font-size: 14px; line-height: 1.4; font-weight: bold;">Global Democracy is possible, if YOU take part in it!</p>
                                <p class="text-white" style="font-size: 14px; line-height: 1.4;">Create your own political proposals or vote on real-world political initiatives.</p>
                                <p class="text-white" style="font-size: 14px; line-height: 1.4; margin-top: 10px;">To start, <a href="{{ path("login") }}" class="text-white" style="text-decoration: underline;">login</a> or create a <a href="{{ path("app_register") }}" class="text-white" style="text-decoration: underline;">user account</a>.</p>
                            </div>
                        </div>
                    </div>

                    {# R1: Abraham Lincoln #}
                    <div class="single-sidebar-widget p-30 m-b-30">
                        <div class="section-heading">
                            <h5 class="text-dark">Abraham Lincoln</h5>
                        </div>
                        <div class="widget-content-bg bg-img bg-overlay p-30" style="background-image: url('{{ asset('assets/img/category/K_33_small.jpg') }}');">
                            <blockquote style="margin-bottom: 0; background-color: transparent; border-left: 3px solid #ffffff;">
                                <h6 class="quote-text text-white" style="font-size: 14px; line-height: 1.6; font-style: italic;">“... that government of the people, by the people, for the people, shall not perish from the earth.”</h6>
                                <h6 class="quote-name" style="font-size: 12px; margin-top: 15px; font-weight: bold; color: #ed1c24;">ABRAHAM LINCOLN</h6>
                            </blockquote>
                        </div>
                    </div>
                    
                    {# L2: Categories Current #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-categories-current">
                        {{ render(controller('App\\Controller\\WidgetController::CategoriesOverviewAction', { 'type': 'current' })) }}
                    </div>

                    {# R2: Categories Future #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-categories-future">
                        {{ render(controller('App\\Controller\\WidgetController::CategoriesOverviewAction', { 'type': 'future' })) }}
                    </div>

                    {# L3: Most Popular #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-popular">
                    {{ render(controller('App\\Controller\\WidgetController::MostPopularAction')) }}
                    </div>

                    {# R3: Most Comments #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-comments">
                        {{ render(controller('App\\Controller\\WidgetController::MostCommentsAction')) }}
                    </div>

                    {# L4: Most Views #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-views">
                        {{ render(controller('App\\Controller\\WidgetController::MostViewsAction')) }}
                    </div>

                    {# R4: Most Delegations #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-delegations">
                        {{ render(controller('App\\Controller\\WidgetController::mostDelegationsAction')) }}
                    </div>

                    {# L5: Most Citizens #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-citizens">
                        {{ render(controller('App\\Controller\\WidgetController::mostCitizensByCountryAction')) }}
                    </div>

                    {# R5: Most Initiatives #}
                    <div class="single-sidebar-widget p-30 m-b-30 w-initiatives">
                        {{ render(controller('App\\Controller\\WidgetController::MostInitiativesAction')) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- >>>>>>>>>>>>>>>>>>>>
        Post Right Sidebar Area
        <<<<<<<<<<<<<<<<<<<<< -->

        <div class="post-sidebar-area right-sidebar m-t-30 m-b-30 box-shadow sticky-sidebar">
            <div class="desktop-only">
                <div class="single-sidebar-widget p-30">
                    <div class="section-heading">
                        <h5 class="text-dark">Abraham Lincoln</h5>
                    </div>
                    <div class="widget-content-bg bg-img bg-overlay p-30" style="background-image: url('{{ asset('assets/img/category/K_33_small.jpg') }}');">
                        <blockquote style="margin-bottom: 0; background-color: transparent; border-left: 3px solid #ffffff;">
                            <h6 class="quote-text text-white" style="font-size: 14px; line-height: 1.6; font-style: italic;">“It is rather for us to be here dedicated to the great task remaining before us [...] that government of the people, by the people, for the people, shall not perish from the earth.”</h6>
                            <h6 class="quote-name" style="font-size: 12px; margin-top: 15px; font-weight: bold; color: #ed1c24;">ABRAHAM LINCOLN</h6>
                        </blockquote>
                    </div>
                </div>
                
                <div class="single-sidebar-widget p-30 w-categories-future">
                    {{ render(controller('App\\Controller\\WidgetController::CategoriesOverviewAction', { 'type': 'future' })) }}
                </div>
                
                <div class="single-sidebar-widget p-30 w-comments">
                    {{ render(controller('App\\Controller\\WidgetController::MostCommentsAction')) }}
                </div>
                <div class="single-sidebar-widget p-30 w-delegations">
                    {{ render(controller('App\\Controller\\WidgetController::mostDelegationsAction')) }}
                </div>
                <div class="single-sidebar-widget p-30 w-initiatives">
                    {{ render(controller('App\\Controller\\WidgetController::MostInitiativesAction')) }}
                </div>
            </div>
        </div> 

    </section>

    <style>
        /* Filter Bar Styling */
        .feed-filter-bar {
            border-bottom: 1px solid #eee;
            padding-bottom: 15px;
        }
        .filter-btn {
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            color: #666;
            font-weight: 600;
            transition: all 0.3s;
        }
        .filter-btn:hover {
            background-color: #eee;
            color: #333;
        }
        .filter-btn.active {
            background-color: #f74a06;
            border-color: #f74a06;
            color: #fff !important;
        }

        /* Sticky Sidebar logic */
        @media (min-width: 1200px) {
            .sticky-sidebar {
                position: -webkit-sticky;
                position: sticky;
                top: 90px; /* Adjust based on your header height */
                height: calc(100vh - 120px);
                overflow-y: auto;
            }
            /* Hide scrollbar for sticky sidebars but keep functionality */
            .sticky-sidebar::-webkit-scrollbar {
                width: 0px;
                background: transparent;
            }
        }

        /* Force Single Column for Feed */
        .single-column-feed {
            display: block !important;
        }
        .single-column-feed .proposal-card {
            width: 100% !important;
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }

        /* Responsive Display Logic */
        @media (min-width: 1200px) {
            .mobile-tablet-only { display: none !important; }
            .desktop-only { display: block !important; }
        }
        @media (max-width: 1199px) {
            .mobile-tablet-only { display: block !important; }
            .desktop-only { display: none !important; }
            
            .post-sidebar-area { display: none !important; }
            .mag-posts-content { 
                -ms-flex: 0 0 100% !important;
                flex: 0 0 100% !important;
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 !important;
            }
        }
        
        /* Tablet Grid (768px - 1199px) */
        @media (min-width: 768px) and (max-width: 1199px) {
            .interleaved-widgets-container {
                display: flex;
                flex-wrap: wrap;
                margin: 0 -15px;
            }
            .interleaved-widgets-container .single-sidebar-widget {
                flex: 0 0 50%;
                max-width: 50%;
                padding: 15px !important;
            }
        }

        /* Mobile Grid (< 768px) */
        @media (max-width: 767px) {
            .mag-posts-content {
                padding-left: 15px !important;
                padding-right: 15px !important;
            }
            .interleaved-widgets-container .single-sidebar-widget {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
        }
    </style>
    <!-- ##### Mag Posts Area End ##### -->

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
